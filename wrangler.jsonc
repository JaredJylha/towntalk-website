// Cloudflare Workers config: serve the prebuilt static site in dist/ (no build step needed).
{
  "name": "towntalk-website",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist"
  },
  // Branch builds run `npx wrangler preview`, which needs this block (it can stay empty).
  "previews": {}
}
